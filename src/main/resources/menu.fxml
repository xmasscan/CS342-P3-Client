<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<?import javafx.geometry.Insets?>
<?import ../User.java?>

<GridPane fx:controller="connect4fxml.LoginControllers" xmlns:fx="http://javafx.com/fxml" alignment="center" hgap="10" vgap="10">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <!--User should store information for this gridpane-->
    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
        <Children>
        <User/>
        <Label text = "current User"/>
        <HBox>
            <ImageView >
                
            </ImageView>
            <VBox>
                <Children>
                    <Label text = "Gold:"/>
                    <Label text = "Elo"/>
                    <Label text = "Win-Loss ratio"/>
                </Children>
            </VBox>
        </HBox>

        </Children>  
    </VBox>

    <!--this will need to change depending on the boder pane at 1, 1-->
    <BorderPane GridPane.columnIndex="1" GridPane.rowIndex="0">
        <Center>
            <Button text = "Start Game"></Button>
        </Center>
    </BorderPane>

    <BorderPane GridPane.columnIndex="0" GridPane.rowIndex="1">
        <Center>
            <Button text = "Sign out"></Button>
        </Center>
    </BorderPane>

    <BorderPane GridPane.columnIndex="0" GridPane.rowIndex="1">
        <padding><Insets top="25" right="25" bottom="10" left="25"/></padding>
        <Center>
            <HBox>
                <Button text = "Play Against AI"></Button>
                <Button text = "Play Against User"></Button>
                <Button text = "Play Game"></Button>

            </HBox>
        </Center>
    </BorderPane>


</GridPane>