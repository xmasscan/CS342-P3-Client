<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<?import javafx.geometry.Insets?>

<VBox fx:controller="MenuControllers" xmlns:fx="http://javafx.com/fxml" alignment="center"  maxHeight = "-Infinity" minHeight = "-Infinity" maxWidth = "-Infinity" minWidth = "-Infinity">
<GridPane fx:id= "root" alignment="center" hgap="10" vgap="10" maxHeight = "-Infinity" minHeight = "-Infinity" maxWidth = "-Infinity" minWidth = "-Infinity">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <HBox GridPane.rowIndex="0">
        <VBox alignment="CENTER" maxWidth="380.0" minWidth = "380" maxHeight = "250.0" minHeight = "250.0" style = "-fx-border-color: black; -fx-border-insets: 5; -fx-border-width: 3; -fx-border-style: dashed;">
            <VBox alignment = "CENTER">
                <Text fx:id = "currentUser" text = "currentUser: "/>
                <Text fx:id = "Elo" text = "Elo: "/>
            </VBox>
        </VBox>

        <!--this will need to change depending on the boder pane at 1, 1-->
        <BorderPane maxWidth = "500.0" minWidth = "500" maxHeight = "250.0" minHeight = "250.0" style = "-fx-border-color: black; -fx-border-insets: 5; -fx-border-width: 3; -fx-border-style: dashed;">
            <center>
                <VBox alignment="CENTER">
                    <Label text="STATUS"/>
                    <Text fx:id="statusText" text="Not Connected to a Match..."/>
                </VBox>
            </center>
        </BorderPane>
    </HBox>
    <HBox GridPane.rowIndex="1">
        <BorderPane GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth = "700.0" minWidth = "700.0" maxHeight = "250.0" minHeight = "250.0" style = "-fx-border-color: black; -fx-border-insets: 5; -fx-border-width: 3; -fx-border-style: dashed;">
            <center>
                <VBox alignment = "CENTER">
                    <Text text="INSTRUCTIONS"/>
                    <Text text="To place a chip, click the column you wish to place it in on your turn."/>
                    <Text text="The first player to line up 4 chips vertically, horizontally, or diagonally wins!"/>
                    <Text text="To send a message, enter a message into the 'Enter a Message!' box and press the checkmark."/>
                    <Text text="To send a message to all concurrent players, prepend your message with \'@everyone\'!"/>
                </VBox>

            </center>
        </BorderPane>

        <BorderPane GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="100.0" minWidth="200.0" maxHeight = "200.0" minHeight = "250.0" style = "-fx-border-color: black; -fx-border-insets: 5; -fx-border-width: 3; -fx-border-style: dashed;">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
            <center>
                <HBox alignment = "CENTER" spacing = "15">
                    <padding><Insets  right="5" left="5"/></padding>

                    <Button fx:id="Game" onAction="#startGame" text = "Play Game" maxWidth = "140" minWidth = "140" maxHeight = "200.0" minHeight = "200.0"></Button>

                </HBox>
            </center>
        </BorderPane>
    </HBox>
</GridPane>

</VBox>